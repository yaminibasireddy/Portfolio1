@charset "utf-8";

:root { --bg-main: #EFEFEA; --bg-card: #FAF8F6; --border: #CFCDC5; --text-main: #111111; --text-muted: #45443F; --accent: #3346A8; --paper: #FFFFFF; --font-serif: "Instrument Serif", Georgia, serif; --font-body: "Inter", Arial, sans-serif; --space-1: 8px; --space-2: 16px; --space-3: 24px; --space-4: 40px; --space-5: 80px; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 88px; }

body { margin: 0px; background: var(--bg-main); color: var(--text-main); font-family: var(--font-body); font-size: 1rem; line-height: 1.65; }

h1, h2, h3 { font-weight: 400; line-height: 1.05; margin: 0 0 var(--space-1); }

h1 { font-size: 5.5rem; letter-spacing: -0.03em; }

h2 { font-size: 3.25rem; letter-spacing: -0.02em; margin-bottom: var(--space-3); }

h3 { font-size: 1.125rem; font-weight: 600; line-height: 1.3; }

p { margin: 0 0 var(--space-1); max-width: 65ch; color: var(--text-muted); }

strong { color: var(--text-main); }

a { color: var(--accent); }

a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

.serif { font-family: var(--font-serif); font-style: italic; letter-spacing: 0px; }

#navbar { position: sticky; top: 0px; z-index: 1; display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-4); background: var(--bg-main); }

.nav-name { font-family: var(--font-serif); font-style: italic; font-size: 1.75rem; color: var(--text-main); text-decoration: none; }

.nav-links { display: flex; gap: var(--space-4); margin: 0px; padding: 0px; list-style: none; }

.nav-link { display: flex; align-items: center; min-height: 44px; color: var(--text-main); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; text-decoration: none; transition: color 0.2s; }

.nav-link:hover { color: var(--accent); }

#hero, section, #contact { max-width: 1120px; margin: 0px auto; padding: var(--space-5) var(--space-4) 0; }

#hero { display: grid; grid-template-columns: 1fr auto; gap: var(--space-4); align-items: start; }

.tags { display: flex; flex-wrap: wrap; gap: var(--space-1); margin: var(--space-3) 0; padding: 0px; list-style: none; }

.tags li { padding: 6px var(--space-2); border: 1px dashed var(--text-main); border-radius: 999px; font-weight: 600; }

#hero .lead { font-size: 1.125rem; }

.actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-4); }

.circle-cta { display: flex; flex-direction: column; justify-content: center; width: 200px; height: 200px; padding: var(--space-3) 28px; border: 1.5px solid var(--text-main); border-radius: 50%; color: var(--text-main); text-decoration: none; transition: background-color 0.2s, color 0.2s; }

.circle-cta:hover { background: var(--text-main); color: var(--paper); }

.circle-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }

.circle-main { font-size: 1.875rem; line-height: 1.1; white-space: nowrap; }

.stats { margin: 0px; text-align: right; }

.stat { margin-bottom: var(--space-4); }

.stat dt { font-size: 0.8125rem; text-transform: uppercase; color: var(--text-muted); }

.stat dd { margin: 0px; font-size: 4rem; font-weight: 300; line-height: 1; }

.btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 var(--space-3); border: 1.5px solid var(--text-main); border-radius: 999px; font-weight: 600; text-decoration: none; white-space: nowrap; transition: background-color 0.2s, color 0.2s, border-color 0.2s; }

.btn-dark { background: var(--text-main); color: var(--paper); }

.btn-dark:hover { background: var(--accent); border-color: var(--accent); }

.btn-secondary { background: transparent; color: var(--text-main); }

.btn-secondary:hover { background: var(--paper); }

.card-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }

.card, .skill-group { padding: var(--space-4); background: var(--bg-card); border: 1px solid var(--border); border-radius: 28px; }

.card-role { color: var(--text-main); font-family: var(--font-serif); font-style: italic; font-size: 1.25rem; line-height: 1.3; }

.card-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--accent); }

.card-link:hover { color: var(--text-main); border-bottom-color: var(--text-main); }

.skill-group ul { margin: 0px; padding-left: var(--space-3); color: var(--text-muted); }

.skill-group li { margin-bottom: var(--space-2); }

#resume .btn { margin-bottom: var(--space-3); }

.sheet { max-width: 800px; padding: var(--space-4); background: var(--paper); border: 1px solid var(--border); }

.sheet p { color: var(--text-main); }

.sheet-header { padding-bottom: var(--space-2); border-bottom: 1px solid var(--text-main); }

.sheet-name { font-family: var(--font-serif); font-style: italic; font-size: 2.25rem; line-height: 1.1; }

.sheet h3 { margin-top: var(--space-3); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.08em; }

.sheet-item { margin-bottom: var(--space-2); }

.sheet-item p { margin: 0px; }

#contact { padding-bottom: var(--space-5); }

.footer-line { font-size: 2.5rem; line-height: 1.15; letter-spacing: -0.02em; color: var(--text-main); }

@media (max-width: 700px) {
  #navbar { flex-wrap: wrap; gap: var(--space-1) var(--space-2); padding: var(--space-1) var(--space-2); }
  .nav-links { order: 3; width: 100%; gap: var(--space-3); }
  #hero, section, #contact { padding: var(--space-4) var(--space-2) 0; }
  #hero { grid-template-columns: 1fr; }
  #contact { padding-bottom: var(--space-4); }
  h1 { font-size: 3.5rem; }
  h2, .footer-line { font-size: 2.25rem; }
  .stats { display: flex; justify-content: space-between; text-align: left; }
  .stat { margin-bottom: 0px; }
  .stat dd { font-size: 2.75rem; }
  .card-grid { grid-template-columns: 1fr; }
  .card, .skill-group, .sheet { padding: var(--space-3); }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .nav-link, .btn, .circle-cta { transition: none; }
}

@media print {
  @page { size: a4; margin: 15mm; }
  body { background: rgb(255, 255, 255); color: rgb(0, 0, 0); font-size: 11pt; }
  #navbar, #hero, #background, #skills, #contact, #resume h2, #resume .btn { display: none; }
  #resume, .sheet { max-width: none; margin: 0px; padding: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }
  .sheet p, .sheet strong, .sheet a, .sheet h3 { color: rgb(0, 0, 0); text-decoration: none; }
}
